# ─── LLM Platform: Environment Variables ─────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# Never commit .env to version control.

# ─── Application ──────────────────────────────────────────────
# Deployment environment: development | staging | production
LLM_PLATFORM_ENV=development

# Secret key for JWT token signing (generate with: openssl rand -hex 64)
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64

# JWT signing algorithm: HS256 | HS384 | HS512 | RS256
JWT_ALGORITHM=HS256

# JWT token expiration in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Application port
APP_PORT=8000

# Maximum request body size in megabytes
MAX_REQUEST_SIZE_MB=100

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=llm_platform
POSTGRES_PASSWORD=llm_platform_secret
POSTGRES_DB=llm_platform
POSTGRES_PORT=5432

# Async database URL (used by SQLAlchemy async engine)
DATABASE_URL=postgresql+asyncpg://llm_platform:llm_platform_secret@localhost:5432/llm_platform

# Sync database URL (used by Alembic migrations)
DATABASE_URL_SYNC=postgresql://llm_platform:llm_platform_secret@localhost:5432/llm_platform

# ─── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# Redis connection URL
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ─── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_USER=llm_platform
RABBITMQ_PASSWORD=rabbitmq_secret
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# RabbitMQ connection URL (URL-encoded vhost)
RABBITMQ_URL=amqp://llm_platform:rabbitmq_secret@localhost:5672/%2F

# ─── Milvus Vector Database ──────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_GRPC_PORT=9091
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_SECURE=false

# ─── MinIO Object Storage ────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_SECURE=false

# ─── Model Provider API Keys ─────────────────────────────────
# OpenAI API key (required for GPT-4o, GPT-4o-mini, embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI organization ID (optional)
OPENAI_ORG_ID=org-your-org-id-here

# Anthropic API key (required for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# DeepSeek API key (required for DeepSeek Chat and Reasoner)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Qwen / Alibaba Cloud API key
QWEN_API_KEY=sk-your-qwen-api-key-here

# Hugging Face token (for downloading models, optional)
HUGGINGFACE_TOKEN=hf_your-huggingface-token-here

# ─── LangSmith (LLM 调用追踪/评测，可选) ───────────────────────
# 留空 = 不启用追踪（容器可直接打开，零开销透传）；填入 key 后自动启用。
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=llm-platform

# ─── Local Model Serving ─────────────────────────────────────
# vLLM base URL for local model inference
VLLM_BASE_URL=http://localhost:8001/v1

# Ollama base URL for local model inference
OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face cache directory for downloaded models
HF_HOME=/app/cache/huggingface

# ─── Observability ───────────────────────────────────────────
# OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=

# OpenTelemetry service name
OTEL_SERVICE_NAME=llm-platform

# ─── Monitoring & Alerts ─────────────────────────────────────
# Prometheus metrics port
METRICS_PORT=9090

# Slack webhook URL for alert notifications
SLACK_WEBHOOK_URL=

# Alert notification email recipients (comma-separated)
ALERT_EMAIL_RECIPIENTS=platform-alerts@example.com

# ─── Security ─────────────────────────────────────────────────
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Allowed hosts for host header validation (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# IP addresses to blacklist (comma-separated)
IP_BLACKLIST=

# IP addresses to whitelist (comma-separated, takes precedence over blacklist)
IP_WHITELIST=

# ─── Docker Compose Specific ─────────────────────────────────
# Container image tags
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine

# Database connection retry count during startup
DB_CONNECTION_RETRIES=30
DB_CONNECTION_RETRY_DELAY=2

# ─── Testing ──────────────────────────────────────────────────
# Test database URL (use a separate database for tests)
TEST_DATABASE_URL=postgresql+asyncpg://llm_platform:llm_platform_secret@localhost:5432/llm_platform_test

# Test Redis URL
TEST_REDIS_URL=redis://:redis_secret@localhost:6379/15

# Coverage threshold (percentage)
COVERAGE_FAIL_UNDER=80
