{
  "dashboard": {
    "uid": "llm-platform-rag",
    "title": "LLM Platform - RAG Performance",
    "description": "RAG pipeline metrics: retrieval latency, cache hits, chunk counts, indexing performance",
    "tags": ["llm", "rag", "retrieval"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "RAG Query Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{endpoint=~\".*rag.*\"}[5m])) by (endpoint)",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10}
          }
        }
      },
      {
        "id": 2,
        "title": "Retrieval Latency (P50/P95/P99)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(rag_retrieval_latency_seconds_bucket[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(rag_retrieval_latency_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(rag_retrieval_latency_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "orange", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Chunks Retrieved per Query",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(rag_chunks_retrieved_bucket[5m]))",
            "legendFormat": "P50 chunks"
          },
          {
            "expr": "histogram_quantile(0.95, rate(rag_chunks_retrieved_bucket[5m]))",
            "legendFormat": "P95 chunks"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth"}
          }
        }
      },
      {
        "id": 4,
        "title": "Cache Hit Rate",
        "type": "timeseries",
        "gridPos": {"h": 7, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(rag_cache_hits_total[5m])) by (level)",
            "legendFormat": "Cache {{level}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": {"drawStyle": "bars", "fillOpacity": 70, "stacking": {"mode": "normal"}}
          }
        }
      },
      {
        "id": 5,
        "title": "Cache Effectiveness",
        "type": "stat",
        "gridPos": {"h": 7, "w": 6, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(rag_cache_hits_total{level!=\"none\"}[1h])) / sum(rate(rag_cache_hits_total[1h])) * 100",
            "legendFormat": ""
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "orange", "value": 50},
                {"color": "green", "value": 80}
              ]
            }
          }
        },
        "options": {
          "textMode": "auto",
          "colorMode": "background"
        }
      },
      {
        "id": 6,
        "title": "Avg Retrieval Latency",
        "type": "stat",
        "gridPos": {"h": 7, "w": 6, "x": 18, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(rag_retrieval_latency_seconds_bucket[1h]))",
            "legendFormat": ""
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "orange", "value": 0.5},
                {"color": "red", "value": 1}
              ]
            }
          }
        },
        "options": {
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 7,
        "title": "Indexing Latency",
        "type": "timeseries",
        "gridPos": {"h": 7, "w": 12, "x": 0, "y": 15},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(rag_index_latency_seconds_bucket[10m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(rag_index_latency_seconds_bucket[10m]))",
            "legendFormat": "P95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth"}
          }
        }
      },
      {
        "id": 8,
        "title": "Indexing Operations",
        "type": "stat",
        "gridPos": {"h": 7, "w": 12, "x": 12, "y": 15},
        "targets": [
          {
            "expr": "sum(increase(rag_index_latency_seconds_count[1h]))",
            "legendFormat": ""
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "blue", "value": null}
              ]
            }
          }
        },
        "options": {
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 9,
        "title": "RAG Endpoint Latency Breakdown",
        "type": "table",
        "gridPos": {"h": 7, "w": 24, "x": 0, "y": 22},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{endpoint=~\".*rag.*\"}[5m])) by (le, endpoint))",
            "legendFormat": "{{endpoint}}",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {"align": "auto"}
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Value"},
              "properties": [
                {"id": "custom.cellOptions", "value": {"mode": "gradient"}},
                {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 2}]}}
              ]
            }
          ]
        }
      }
    ]
  },
  "overwrite": true
}
